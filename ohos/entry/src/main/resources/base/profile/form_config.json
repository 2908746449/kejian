{
  "forms": [
    {
      "name": "KejianCompact",
      "displayName": "$string:form_compact_name",
      "description": "$string:form_description",
      "src": "./ets/widget/CompactForm.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "light",
      "isDefault": true,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": [
        "2*2"
      ],
      "isDynamic": true
    },
    {
      "name": "KejianWide",
      "displayName": "$string:form_wide_name",
      "description": "$string:form_description",
      "src": "./ets/widget/WideForm.ets",
      "uiSyntax": "arkts",
      "window": {
        "designWidth": 720,
        "autoDesignWidth": true
      },
      "colorMode": "light",
      "isDefault": false,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*4",
      "supportDimensions": [
        "2*4"
      ],
      "isDynamic": true
    }
  ]
}
